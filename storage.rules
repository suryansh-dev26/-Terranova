rules_version = '2';

// Firebase Storage rules for RunRealm3. Only profile avatars are stored:
// users/{uid}/avatar.jpg, written by the owner, readable by everyone (they
// render on the public leaderboard). Everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
